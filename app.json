{
  "expo": {
    "name": "greenroom",
    "slug": "greenroom",
    "scheme": "greenroom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codeflixacademy.greenroom",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow greenroom to use the microphone so you can record harmonies and rehearsal notes."
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow greenroom to use the camera so you can record dance videos and scene recordings.",
          "photosPermission": "Allow greenroom to access your photos so you can pick a dance video to attach."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "be26ed9a-feb8-4da8-9ed7-79d0ae766273"
      }
    },
    "owner": "jluomein"
  }
}
